flowchart TD
    Start([Open]) --> Check{Session valid?}

    Check -- no --> Welcome["/welcome"]
    Welcome -- "sign in" --> Login["/login"]
    Welcome -- "create an account" --> Register
    Welcome --> About["/about"]
    Check -- yes --> Home["/"]

    Login -- "no account yet" --> Register["/register"]
    Register -- created --> Home
    Register -- abandoned --> Login

    Login -- correct --> Home
    Login -- wrong --> Login

    Home -- "log something" --> New["/transactions/new"]
    New -- stored --> Home
    New -- abandoned --> Home

    Home -- "pick an entry" --> Edit["/transactions/:id"]
    Edit -- "corrected or removed" --> Home
    Edit -- abandoned --> Home

    Home --> Budget["/budget"]
    Budget -- "cap saved" --> Home
    Budget -- "abandoned" --> Home

    Home --> Stats["/stats"]
    Stats --> Home

    Home --> Debts["/debts"]
    Debts -- "write one down" --> DebtNew["/debts/new"]
    DebtNew -- stored --> Debts
    DebtNew -- abandoned --> Debts
    Debts -- "settled or removed" --> Debts
    Debts --> Home

    Home -- "☰ menu" --> Profile["/profile"]
    Profile -- saved --> Home
    Home -- "☰ menu" --> Categories["/categories"]
    Categories -- "pick one" --> Category["/categories/:id"]
    Category -- "pick an entry" --> Edit
    Home -- "☰ menu" --> About
    Home -- "☰ menu" --> Delete["/account/delete"]
    Delete -- "deleted, after Are you sure?" --> Welcome
    Delete -- abandoned --> Home

    Home -- "sign out" --> Welcome