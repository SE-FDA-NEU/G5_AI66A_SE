flowchart TD
Start([Open]) --> Check{Session valid?}
Check -- no --> Login["/login"]
Check -- yes --> Home

    Login -- "no account yet" --> Register["/register"]
    Register -- created --> Home
    Login -- correct --> Home["/ overview"]
    Login -- wrong --> Login

    Home -- "log something" --> New["/transactions/new"]
    New -- stored --> Home
    New -- abandoned --> Home

    Home -- "pick an entry" --> Edit["/transactions/:id"]
    Edit -- "corrected or removed" --> Home

    Home --> Budget["/budget"]
    Budget -- "cap saved" --> Home

    Home --> Stats["/stats"]
    Stats --> Home

    Home -- "sign out" --> Login
