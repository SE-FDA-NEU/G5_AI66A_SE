# Copy this file to backend/.env, next to it. The values below work as they are on a
# development machine, so a first run needs no changes.
# .env is ignored by git: never commit it, and never reuse this SECRET_KEY on a real server.

# Where the database lives. A relative path is read from the backend/ folder, so this is
# backend/expense.db, created by `python -m scripts.seed_data`.
DATABASE_URL=sqlite:///./expense.db

# Signs the sign-in tokens. Any random string of 32 characters or more works. To make your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-3f9a1c7e5b2d4a6c8e0f1a3b5c7d9e1f

# Days a sign-in lasts before the password is asked for again (BR10).
SESSION_DAYS=7

# Web pages allowed to call the API from a browser, separated by commas. * allows any page, which
# is fine on a development machine; on a server, list the exact addresses instead.
CORS_ORIGINS=*
